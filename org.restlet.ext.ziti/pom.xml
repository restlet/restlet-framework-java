<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.restlet</groupId>
		<artifactId>org.restlet.parent</artifactId>
		<version>3.0.0-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>org.restlet.ext.ziti</artifactId>
	<name>Restlet Framework - OpenZiti extension</name>
	<description>Routes HTTP client calls over an OpenZiti overlay network.</description>

	<!-- The OpenZiti SDK pulls several versions of these: converge on the SDK's own Kotlin and on
	     the Gson version of the Restlet build. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-stdlib</artifactId>
				<version>2.4.20</version>
			</dependency>
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-reflect</artifactId>
				<version>2.4.20</version>
			</dependency>
			<dependency>
				<groupId>org.jetbrains</groupId>
				<artifactId>annotations</artifactId>
				<version>23.0.0</version>
			</dependency>
			<dependency>
				<groupId>com.google.code.gson</groupId>
				<artifactId>gson</artifactId>
				<version>${lib-gson-version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.restlet</groupId>
			<artifactId>org.restlet</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- The OpenZiti SDK. Its ziti-netty channel isn't used, see ZitiSocketChannel. -->
		<dependency>
			<groupId>org.openziti</groupId>
			<artifactId>ziti</artifactId>
			<version>${lib-ziti-version}</version>
			<exclusions>
				<!-- Runtime dependencies of the SDK's own command line, which an application
				     embedding it doesn't need: a logging backend and a CLI parser. -->
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-simple</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.github.ajalt</groupId>
					<artifactId>clikt</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- The SDK's ServiceDetail model carries Jackson 2 annotations that the SDK only needs at
		     run time; javac reads them when compiling against it. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
			<version>${lib-jackson-annotations-version}</version>
			<scope>provided</scope>
		</dependency>
		<!-- Likewise for the kotlin.Metadata annotation of the SDK classes. -->
		<dependency>
			<groupId>org.jetbrains.kotlin</groupId>
			<artifactId>kotlin-stdlib</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>${lib-junit-version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
