<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.restlet</groupId>
        <artifactId>org.restlet.parent</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>org.restlet.ext.smithy.server</artifactId>
    <name>Restlet Framework - Smithy server extension</name>
    <description>Experimental smithy-java server host on Restlet HTTP connectors.</description>
    <!-- No module descriptor: in smithy-java 1.8.0, server-api and server-core split package
         software.amazon.smithy.java.server, so its server only runs on the class path. -->
    <properties>
        <!-- The Smithy version used by smithy-java. -->
        <lib-smithy-version>1.74.0</lib-smithy-version>
        <smithy.output>${project.build.directory}/smithy</smithy.output>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.restlet</groupId>
            <artifactId>org.restlet</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The smithy-java server API is @SmithyUnstableApi in 1.8.0. Applications add the
             protocol modules they serve, such as aws-server-restjson or server-rpcv2-cbor. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>server-core</artifactId>
            <version>${lib-smithy-java-version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-server-restjson</artifactId>
            <version>${lib-smithy-java-version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.restlet</groupId>
            <artifactId>org.restlet.ext.smithy</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-client-restjson</artifactId>
            <version>${lib-smithy-java-version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Generate the client and server of src/test/smithy, see below. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>codegen-plugin</artifactId>
            <version>${lib-smithy-java-version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy</groupId>
            <artifactId>smithy-cli</artifactId>
            <version>${lib-smithy-version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${lib-junit-version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${lib-junit-version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.restlet.ext.smithy.server</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- Generated exceptions have no serialVersionUID, and generated
                                 services overload each operation for sync and async handlers. -->
                            <compilerArgs combine.children="append">
                                <arg>-Xlint:-serial,-overloads</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Generates SDK code from src/test/smithy with smithy-java, for the tests. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>smithy-codegen</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>software.amazon.smithy.cli.SmithyCli</argument>
                                <argument>build</argument>
                                <argument>--config</argument>
                                <argument>${project.basedir}/src/test/smithy/smithy-build.json</argument>
                                <argument>--output</argument>
                                <argument>${smithy.output}</argument>
                                <argument>--discover</argument>
                                <argument>${project.basedir}/src/test/smithy</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-generated-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${smithy.output}/source/java-codegen/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
