$version: "2"

namespace restlet.test

use aws.protocols#restJson1

/// A small service whose client and server are generated by smithy-java for the tests.
@restJson1
service Greeter {
    version: "1"
    operations: [Greet, Upload]
    errors: [Refused]
}

@http(method: "POST", uri: "/greet/{name}")
operation Greet {
    input := {
        @required
        @httpLabel
        name: String

        @httpQuery("punctuation")
        punctuation: String

        @httpHeader("x-greeting")
        greeting: String
    }
    output := {
        message: String
    }
}

@idempotent
@http(method: "PUT", uri: "/upload")
operation Upload {
    input := {
        @required
        @httpPayload
        body: Payload
    }
    output := {
        @httpHeader("x-received")
        received: String
    }
}

@streaming
blob Payload

@error("client")
@httpError(400)
structure Refused {
    reason: String
}
