$version: "2"

namespace restlet.test.server

use aws.protocols#restJson1

/// A small service whose client and server are generated by smithy-java for the tests.
@restJson1
service Notes {
    version: "1"
    operations: [PutNote, GetNote, Upload, RequiredUpload, Wait]
    errors: [NoteNotFound]
}

@idempotent
@http(method: "PUT", uri: "/notes/{id}")
operation PutNote {
    input := {
        @required
        @httpLabel
        @length(min: 1, max: 16)
        id: String

        @required
        @length(max: 64)
        text: String
    }
    output := {}
}

@readonly
@http(method: "GET", uri: "/notes/{id}")
operation GetNote {
    input := {
        @required
        @httpLabel
        id: String
    }
    output := {
        text: String
    }
    errors: [NoteNotFound]
}

@http(method: "POST", uri: "/upload")
operation Upload {
    input := {
        // Defaulted: smithy-java 1.8.0's server validation rejects a required streaming member.
        @httpPayload
        body: Payload = ""
    }
    output := {
        @httpHeader("x-received")
        received: Long
    }
}

/// Like Upload, with a required payload, which smithy-java 1.8.0's server always rejects.
@http(method: "POST", uri: "/required-upload")
operation RequiredUpload {
    input := {
        @required
        @httpPayload
        body: Payload
    }
    output := {}
}

/// Blocks until released, interrupted or timed out.
@http(method: "POST", uri: "/wait")
operation Wait {
    input := {
        @httpQuery("tag")
        tag: String
    }
    output := {}
}

@streaming
blob Payload

@error("client")
@httpError(404)
structure NoteNotFound {
    id: String
}
