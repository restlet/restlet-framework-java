$version: "2"

namespace restlet.test.cbor

use smithy.protocols#rpcv2Cbor

/// An RPCv2 CBOR service whose client and server are generated by smithy-java for the tests.
@rpcv2Cbor
service Counter {
    version: "1"
    operations: [Add]
    errors: [Overflow]
}

operation Add {
    input := {
        @required
        @range(min: 0)
        value: Long

        @required
        @length(max: 32)
        label: String
    }
    output := {
        total: Long
        label: String
    }
}

@error("client")
structure Overflow {
    total: Long
}
